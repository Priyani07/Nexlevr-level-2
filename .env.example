# Run npm run setup, then edit only MONGO_URI in the generated .env.
# Use your Atlas database user's credentials, not your Atlas website login.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/shoplane?retryWrites=true&w=majority
# Explicit database selection also works with a URI ending in /?...
MONGO_DB_NAME=shoplane
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTO_SEED=true
TRUST_PROXY=1
NODEJS_HELPERS=0
